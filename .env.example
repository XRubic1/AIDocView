# Credyx / AIDocView — environment variables

# Required — Supabase (browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Supabase service role — local scripts only (create-admin); never expose to the browser
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=admin@credyx.net
# ADMIN_PASSWORD=choose-a-strong-password

# Edge Function secrets (set in Supabase dashboard, not in client .env)
# OPENAI_API_KEY=
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Credyx <notifications@yourdomain.com>
# SITE_URL=https://app.yourdomain.com

# Optional — Stripe (billing)
# VITE_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# AI model overrides (optional)
# VITE_AI_PRIMARY_MODEL=
# VITE_AI_FALLBACK_MODEL=

# Do NOT set VITE_OPENAI_API_KEY — OpenAI calls go through the openai-proxy Edge Function.

# Enrollment alert recipient (defaults to admin@credyx.com)
# VITE_ADMIN_ALERT_EMAIL=ops@yourdomain.com
