# Credyx / AIDocView — environment variables

# Required — Supabase (browser)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Public site origin (emails, marketing → portal links). Same domain as this deploy when
# Vercel runs the full app (`npm run build`). Example: https://credyx.net
# VITE_PUBLIC_APP_URL=https://credyx.net

# Supabase service role — local scripts only (create-admin); never expose to the browser
# SUPABASE_SERVICE_ROLE_KEY=
# ADMIN_EMAIL=admin@credyx.net
# ADMIN_PASSWORD=choose-a-strong-password

# Edge Function secrets (set in Supabase dashboard, not in client .env)
# OPENAI_API_KEY=
# BROKERSNAPSHOT_API_KEY=   # BrokerSnapshot bearer token — used by brokersnapshot-proxy
# RESEND_API_KEY=
# RESEND_FROM_EMAIL=Credyx <notifications@credyx.net>
# RESEND_FROM_BROKER=Credyx Billing <billing@credyx.net>
# RESEND_FROM_CARRIER=Credyx Ops <ops@credyx.net>
# Optional reply destinations (otherwise replies go to From):
# RESEND_REPLY_TO_BROKER=billing@credyx.net
# RESEND_REPLY_TO_CARRIER=ops@credyx.net
# SITE_URL=https://app.yourdomain.com

# Optional — Stripe (billing)
# VITE_STRIPE_PUBLISHABLE_KEY=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# AI model overrides (optional)
# VITE_AI_PRIMARY_MODEL=
# VITE_AI_FALLBACK_MODEL=
# Show Assistant token/cost meter outside local DEV (testing only)
# VITE_ASSISTANT_SHOW_USAGE=true
# Assistant chat model (default gpt-4o-mini — cheap; document review keeps its own models)
# VITE_ASSISTANT_CHAT_MODEL=gpt-4o-mini

# Do NOT set VITE_OPENAI_API_KEY — OpenAI calls go through the openai-proxy Edge Function.

# Enrollment / waitlist alert recipient (defaults to admin@credyx.com)
# VITE_ADMIN_ALERT_EMAIL=ops@yourdomain.com
